# @file .gitignore
# @description Archivo de configuracion o soporte del proyecto.
# @symbols N/A

# ===== Python =====
venv/
__pycache__/
*.pyc

# ===== Node =====
node_modules/
dist/
build/
/.pnp
.pnp.js

# next.js
/.next/
/out/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ===== Env =====
.env
.env.local
.env.production
.env.*.local
backend/.env

# ===== Logs =====
*.log

# ===== Coverage =====
coverage/

# ===== OS =====
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
