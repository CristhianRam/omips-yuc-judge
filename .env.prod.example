# ═══════════════════════════════════════════════════
# Production Environment Variables
# Copy this file to .env on your VPS at /opt/omips/
# ═══════════════════════════════════════════════════

# ─── Domain ───
DOMAIN=beepercodes.win

# ─── GHCR (GitHub Container Registry) ───
GHCR_OWNER=your-github-username

# ─── PostgreSQL ───
POSTGRES_DB=judge
POSTGRES_USER=judge
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32

# ─── Redis ───
REDIS_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32

# ─── Backend API ───
DATABASE_URL=postgresql://judge:SAME_AS_POSTGRES_PASSWORD@db:5432/judge
SECRET_KEY=CHANGE_ME_use_openssl_rand_base64_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_admin_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_VERIFICATION_TTL_MINUTES=10

# ─── Frontend ───
AUTH_SECRET=CHANGE_ME_use_openssl_rand_base64_32
